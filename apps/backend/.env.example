DATABASE_URL="postgresql://tuteur:tuteur@localhost:5432/tuteur?schema=public"
PORT=3001

# Secret behind the session cookies. Unset = random per boot (sessions reset on
# every restart); set a long random value on a real deployment.
AUTH_SECRET=""

ANTHROPIC_API_KEY=""

# Source lesson images. The production backend image defaults to /data/uploads;
# mount that path on a persistent volume before ingesting real lessons.
INGEST_UPLOAD_DIR=".uploads"

# Langfuse observability (optional). Without both keys the integration stays off
# and the app runs unchanged. Get keys from a project on https://cloud.langfuse.com
# (or a self-hosted instance via LANGFUSE_BASE_URL).
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="https://cloud.langfuse.com"

# Per-role model overrides (optional). Role ∈ classifier, evaluate, socratic,
# ingest_parse, session_analysis, judge. Uppercase the role in the var name.
# Switching provider needs its @langchain/<provider> package installed AND the
# provider's own API key set (e.g. OPENAI_API_KEY for provider "openai").
# ingest_parse must stay on an image-capable model.
# LLM_PROVIDER_SOCRATIC="openai"
# LLM_MODEL_SOCRATIC="gpt-5.6-luna"
# LLM_TEMPERATURE_SOCRATIC="0.5"
